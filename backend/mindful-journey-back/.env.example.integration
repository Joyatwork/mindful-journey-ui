# Configuration pour l'intégration avec le frontend React

# URLs
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
SESSION_DOMAIN=localhost

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SAME_SITE=lax

# Base de données (exemple SQLite pour démarrage rapide)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Ou MySQL si vous préférez :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=mindful_journey
# DB_USERNAME=root
# DB_PASSWORD=
